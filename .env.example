# llama-cpp-agent-proxy environment variables
# Copy this file to .env and adjust values as needed.

# Host of the upstream llama-server (default: 127.0.0.1)
TARGET_HOST=127.0.0.1

# Port of the upstream llama-server (default: 11435)
TARGET_PORT=11435

# Port the proxy listens on (default: 11437)
PORT=11437

# Path to concise log file (default: proxy.log)
LOG_FILE=proxy.log

# Path to full log file (default: proxy-full.log)
FULL_LOG_FILE=proxy-full.log

# NON_STOP_MODE: when true, the proxy sends follow-up prompts that encourage
# the model to continue working on the backlog or live-testing/fixing/polishing
# the app according to documentation flows instead of just calling a tool.
# FINISHED is NOT accepted as a completion signal when NON_STOP_MODE is true.
# Default: false (disabled, FINISHED is accepted). Set to true to enable non-stop mode.
NON_STOP_MODE=false
