# llama-cpp-agent-proxy environment variables
# Copy this file to .env and adjust values as needed.

# Host of the upstream llama-server (default: 127.0.0.1)
TARGET_HOST=127.0.0.1

# Comma-separated list of upstream ports for multi-backend routing
BACKEND_PORTS=11435,11438

# Comma-separated list of systemd service names for monitoring
BACKEND_SERVICES=llama-server-main,lms-micro

# Port the proxy listens on (default: 11437)
PORT=11437

# Path to concise log file (default: proxy.log)
LOG_FILE=proxy.log

# Path to full log file (default: proxy-full.log)
FULL_LOG_FILE=proxy-full.log

# MONITOR_ENABLED: enables background liveness monitoring and auto-restarts.
MONITOR_ENABLED=true

# NON_STOP_MODE: when true, the proxy sends follow-up prompts that encourage
# the model to continue working on the backlog or live-testing/fixing/polishing
# the app according to documentation flows instead of just calling a tool.
# FINISHED is NOT accepted as a completion signal when NON_STOP_MODE is true.
# Default: false (disabled, FINISHED is accepted). Set to true to enable non-stop mode.
NON_STOP_MODE=false

# BUSY_REDIRECT_*: when the main llama-server is busy, redirect to this MLX backend.
BUSY_REDIRECT_HOST=192.168.8.124
BUSY_REDIRECT_PORT=1234
BUSY_REDIRECT_MODEL=mtplx-qwen36-27b-optimized-speed
BUSY_REDIRECT_API_KEY=

# MAX_RESPONSE_TOKENS: default max tokens for responses (default: 4096).
# Set to 0 to disable the override. Clients that set max_tokens in their
# request are unaffected.
MAX_RESPONSE_TOKENS=4096

# MAX_RESPONSE_TOKENS: default max tokens for responses (default: 4096).
# Set to 0 to disable the override. Clients that set max_tokens in their
# request are unaffected.
MAX_RESPONSE_TOKENS=4096
